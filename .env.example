# Copy to .env.local and fill in ONE free key. Never commit real keys.
# Gemini free tier (default): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier (fallback if no Gemini key): https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=   LLM_API_KEY=   (any OpenAI-compatible endpoint)
# Force the keyless demo mode:
# MOCK_LLM=1
