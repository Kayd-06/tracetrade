# Copy to .env.local and fill in ONE free key. Never commit real keys.
# Gemini free tier (default): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier (used automatically if Gemini fails or is unset): https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash   GROQ_MODEL=openai/gpt-oss-120b   (pin one model; default is a free-tier fallback chain)
# LLM_BASE_URL=   LLM_API_KEY=   (any OpenAI-compatible endpoint)
# Force the keyless demo mode:
# MOCK_LLM=1
